        "displaySimilarityBoost": "75%",
        "displayStyle": "10%",
        "displaySpeakerBoost": "Enabled"
      }
    }
  },
  "paths": {
    "episodeOutputPattern": "outputs/episodes/{foodId}-compact",
    "productionVoicePattern": "production/episodes/{foodId}/voice",
    "docsAudioPattern": "docs/audio/episodes/{foodId}",
