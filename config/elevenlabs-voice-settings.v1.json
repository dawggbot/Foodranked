{
  "schemaVersion": "foodranked-elevenlabs-voice-settings.v1",
  "defaultProfile": "eryn_measured_v1",
  "environment": {
    "apiKeyVariable": "ELEVENLABS_API_KEY"
  },
  "generationDefaults": {
    "modelId": "eleven_multilingual_v2",
    "outputFormat": "mp3_44100_128",
    "voiceSettings": {
      "stability": 0.5,
      "similarity_boost": 0.75,
      "style": 0.1,
      "use_speaker_boost": true,
      "speed": 1.12
    },
    "source": {
      "capturedFrom": "ElevenLabs UI screenshot supplied 2026-05-22",
      "displayModel": "Eleven Multilingual v2",
      "displaySpeed": "1.12",
      "displayStability": "50%",
      "displaySimilarityBoost": "75%",
      "displayStyle": "10%",
      "displaySpeakerBoost": "Enabled"
    }
  },
  "narrationDurationPolicy": {
    "maximumSeconds": 180,
    "defaultSpeed": 1.12,
    "overLimitSpeed": 1.13,
    "rule": "Use 1.12 for every narration take. If the completed narration alone exceeds 180 seconds, regenerate once at 1.13 using --over-limit-speed. Do not introduce other per-video speed variation."
  },
  "voiceSelection": {
    "defaultMode": "random_suitable",
    "fallbackProfile": "eryn_measured_v1",
    "endpoint": "https://api.elevenlabs.io/v2/voices",
    "pageSize": 100,
    "voiceTypes": [
      "default",
      "saved"
    ],
    "suitability": {
      "requireEnglish": true,
      "minScore": 2,
      "excludedCategories": [
        "cloned"
      ],
      "preferredTerms": [
        "professional",
        "narration",
        "narrator",
        "informative",
        "educational",
        "documentary",
        "news",
        "clear",
        "confident",
        "calm",
        "neutral",
        "articulate",
        "crisp",
        "warm",
        "friendly",
        "conversational",
        "mature",
        "adult",
        "studio"
      ],
      "excludedTerms": [
        "silly",
        "cartoon",
        "character",
        "comedy",
        "comedic",
        "parody",
        "child",
        "kid",
        "teen",
        "whisper",
        "horror",
        "shout",
        "shouting",
        "scream",
        "singing",
        "song",
        "music",
        "theatrical",
        "exaggerated",
        "raspy",
        "hoarse",
        "mumble",
        "mumbling",
        "slurred",
        "robotic",
        "heavy accent",
        "strong accent",
        "thick accent"
      ]
    }
  },
  "profiles": {
    "eryn_measured_v1": {
      "label": "Eryn - Informative, Neutral and Measured",
      "voiceId": "RaFzMbMIfqBcIurH6XF9",
      "modelId": "eleven_multilingual_v2",
      "outputFormat": "mp3_44100_128",
      "voiceSettings": {
