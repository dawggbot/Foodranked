        "historyItemId": "x1dcWzbYRjzdlwNR9KPV"
      },
      "productionAudioFile": "production/episodes/black-beans/voice/voice-v2-blocks/09-cons.mp3"
    },
    {
      "id": "10-closing_summary",
      "index": 9,
      "kind": "closing_summary",
      "sectionKey": null,
      "text": "Big strengths are protein, fibre, and magnesium, but the biggest weaknesses are low vitamin C, low zinc, and low fat quality. It's good for digestion, heart health, and energy because fibre helps digestion and keeps meals steadier, fibre is useful for heart health, and the carb section gives it a clear fuel role.",
      "textSha256": "989867ed26821a50af94d63a93f5f946643807a60453a5c1115bfb0be9b09483",
