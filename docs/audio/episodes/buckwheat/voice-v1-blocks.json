    {
      "id": "07-minerals",
      "index": 6,
      "kind": "section",
      "sectionKey": "minerals",
      "text": "Magnesium is 55% daily value, adding useful mineral support. Calcium is only 1% daily value, not bringing much bone support. For grains, minerals help round out the score when the carbs are decent.",
      "textSha256": "0bf0a1c8b4a31c4535c9e3c047d63f4feaa0626545b492a8e44485428b39a5b8",
      "characterCount": 197,
