          "truePeakDb": -1.5,
          "loudnessRange": 11,
          "appliedAt": "2026-08-09T16:52:53.747Z"
        }
      },
      "productionAudioFile": "production/episodes/tater-tots/voice/voice-v1-blocks/09-cons.mp3"
    },
    {
      "id": "10-closing_summary",
      "index": 9,
      "kind": "closing_summary",
      "sectionKey": null,
      "text": "Best bits are convenience, texture, and some starch energy. Weak spots are glycemic index, low potassium, and the processed fried format. Best for occasional comfort-food sides, not daily staple carbs. Essentially this convenience food format takes a basic tuber idea and just makes the nutrition tradeoff worse.",
      "textSha256": "abc46b0c5dd6c2c4396186df6db6245a22915c18eef8fe7bc6544e5ac3664b25",
