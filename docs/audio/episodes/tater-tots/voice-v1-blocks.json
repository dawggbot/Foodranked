          "truePeakDb": -1.5,
          "loudnessRange": 11,
          "appliedAt": "2026-08-09T16:52:53.747Z"
        }
      },
      "productionAudioFile": "production/episodes/tater-tots/voice/voice-v1-blocks/08-pros.mp3"
    },
    {
      "id": "09-cons",
      "index": 8,
      "kind": "section",
      "sectionKey": "cons",
      "text": "The drawbacks next: still a processed fried snack. The original potato identity is not enough to save it. Cooking methods and preparation can impact a lot. Deep frying can push calories up to around 250 and add about 7 grams of fat. Easy to overeat as a side. Small pieces make casual portions creep up quickly.",
      "textSha256": "7864b3e341a429245a7b90bbb57e3d9c464740357a1bb2d7ac2d528043c3ebfc",
      "characterCount": 311,
