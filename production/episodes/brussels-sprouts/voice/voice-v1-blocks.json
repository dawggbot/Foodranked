    {
      "id": "04-carbs",
      "index": 3,
      "kind": "section",
      "sectionKey": "carbs",
      "text": "9.6 grams of carbs. Glycemic index is 15, landing in the strongest band for steadier carb behaviour. Fibre is 4.8 grams, strong for a vegetable and useful for digestion and fullness. Starch is only 0.6 grams, but that is expected for a non-starchy vegetable.",
      "textSha256": "7842e13d300ce6e17562d8883661ee15d400c9531e9b39a7cb4034528154259d",
      "characterCount": 258,
      "byteLength": 254999,
      "mediaDurationSeconds": 15.909,
      "audioFile": "production/episodes/brussels-sprouts/voice/voice-v1-blocks/04-carbs.mp3",
      "timingFile": "production/episodes/brussels-sprouts/voice/voice-v1-blocks/04-carbs-timing.json",
      "elevenLabs": {
