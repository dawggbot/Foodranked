    {
      "id": "05-proteins",
      "index": 4,
      "kind": "section",
      "sectionKey": "proteins",
      "text": "No scored protein section here. Collagen, amino-acid scores, and bioavailability are not applicable because there is no protein to judge. For oils and fats, protein is not the role.",
      "textSha256": "c58055ea7702c8938703c7e0fd8502e28a64ed22b958e14cc8ec05ab50330247",
      "characterCount": 181,
