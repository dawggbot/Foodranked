        "historyItemId": "VGPYW1ya8hBLyUPIv05O"
      }
    },
    {
      "id": "07-minerals",
      "index": 6,
      "kind": "section",
      "sectionKey": "minerals",
      "text": "Minerals are basically absent. Iron is 3% daily value, the best number here but still tiny. Magnesium is 0% daily value, and calcium is 0% daily value too. For oils and fats, minerals rarely carry much, and they definitely do not here.",
      "textSha256": "7f31b9babe63f7d497be964451775147ecdec3102fe5157600b20ebf56e51f7c",
      "characterCount": 235,
      "byteLength": 246222,
      "audioFile": "production/episodes/extra-virgin-olive-oil/voice/voice-v1-blocks/07-minerals.mp3",
      "elevenLabs": {
