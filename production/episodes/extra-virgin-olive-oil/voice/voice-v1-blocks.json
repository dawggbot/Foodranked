      }
    },
    {
      "id": "06-vitamins",
      "index": 5,
      "kind": "section",
      "sectionKey": "vitamins",
      "text": "Vitamin E is 93% daily value, the clear vitamin strength. Vitamin K is 50% daily value, so there is real backup too. Vitamin A is 0% daily value, so this is not broad vitamin coverage. For oils and fats, vitamin E and K are the useful micronutrient story.",
      "textSha256": "78d32f571070538dd870618786aae226dfdc0ed762106cec7721f5a89ad388dd",
      "characterCount": 255,
      "byteLength": 277568,
      "audioFile": "production/episodes/extra-virgin-olive-oil/voice/voice-v1-blocks/06-vitamins.mp3",
      "elevenLabs": {
