    {
      "id": "04-carbs",
      "index": 3,
      "kind": "section",
      "sectionKey": "carbs",
      "text": "No scored carb section here. Fibre, sugar, starch, and glycemic index are not applicable for this pure oil. For oils and fats, carbs are basically off the table, so this section does not move the ranking.",
      "textSha256": "9d396f66109d60939b4615b24ff228c01780861f05fd52eeb0896559fa35e2a9",
