        "historyItemId": "8shmh7AHpcoxps76kRHq"
      },
      "productionAudioFile": "production/episodes/cannellini-beans/voice/voice-v2-blocks/05-proteins.mp3",
      "filename": "05-proteins.mp3",
      "docsAudioFile": "audio/episodes/cannellini-beans/voice-v2-blocks/05-proteins.mp3",
      "durationSeconds": 17.267,
