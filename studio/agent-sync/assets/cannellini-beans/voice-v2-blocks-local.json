    {
      "id": "05-proteins",
      "index": 4,
      "kind": "section",
      "sectionKey": "proteins",
      "text": "21.6 grams of protein. Essential amino acids score 9 out of 9, meaning all 9 groups the body must obtain from food clear the useful threshold. Bioavailability is 80%, a solid result for bean protein. For legumes, useful protein combined with slow carbs is the whole point, and cannellini beans deliver both.",
      "textSha256": "8465d0f32f7af63e3ae2913e843270bdbe1d96949ce6a51c09254f48a36fc86a",
      "characterCount": 307,
      "byteLength": 276733,
      "mediaDurationSeconds": 17.267,
      "audioFile": "/studio-data/uploads/narration/cannellini-beans/05-proteins.mp3",
      "timingFile": "production/episodes/cannellini-beans/voice/voice-v2-blocks/05-proteins-timing.json",
      "elevenLabs": {
