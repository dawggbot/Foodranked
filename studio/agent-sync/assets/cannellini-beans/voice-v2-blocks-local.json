    {
      "id": "04-carbs",
      "index": 3,
      "kind": "section",
      "sectionKey": "carbs",
      "text": "59.8 grams of carbs. Starch is 29.9 grams, providing useful staple energy. Fibre is an excellent 15.2 grams, supporting digestion and helping slow the carb response. The glycemic index is only 31, meaning the carbs raise blood glucose relatively slowly. For legumes, this combination of fibre and low glycemic behaviour is one of the main wins.",
      "textSha256": "a7a96d1391a363baa785a1c189b3cf9bac7f2a4b01ef396267eec69e2cef91da",
      "characterCount": 344,
      "byteLength": 331903,
      "mediaDurationSeconds": 20.715,
      "audioFile": "/studio-data/uploads/narration/cannellini-beans/04-carbs.mp3",
      "timingFile": "production/episodes/cannellini-beans/voice/voice-v2-blocks/04-carbs-timing.json",
      "elevenLabs": {
        "requestId": "3Egl7PcyiliPt4nV4O7R",
        "historyItemId": "VKtLs6bktI4oMBDGArm3"
      },
      "productionAudioFile": "production/episodes/cannellini-beans/voice/voice-v2-blocks/04-carbs.mp3",
      "filename": "04-carbs.mp3",
      "docsAudioFile": "audio/episodes/cannellini-beans/voice-v2-blocks/04-carbs.mp3",
      "durationSeconds": 20.715,
      "offsetSeconds": 20.354,
      "wordCount": null,
      "loss": null
