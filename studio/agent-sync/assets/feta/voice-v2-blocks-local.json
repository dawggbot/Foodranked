    {
      "id": "05-proteins",
      "index": 4,
      "kind": "section",
      "sectionKey": "proteins",
      "text": "14.2 grams of protein. Essential amino acids score 9 out of 9. The full set makes this useful protein for repair and maintenance. Bioavailability is 92%, meaning most of that dairy protein should be digestible and usable. Nonessential amino acids score 8 out of 11, a softer mark, but your body can make many itself. For dairy, protein quality is a real strength.",
      "textSha256": "faa4970b812dc8536dfff1a75e2d491e5d9ed328a2dd8073285ceb83ec1128dd",
      "characterCount": 363,
      "byteLength": 314767,
      "mediaDurationSeconds": 19.644,
      "audioFile": "/studio-data/uploads/narration/feta/05-proteins.mp3",
      "timingFile": "production/episodes/feta/voice/voice-v2-blocks/05-proteins-timing.json",
      "elevenLabs": {
        "requestId": "ywflpxMERTeAiT8kQcVM",
        "historyItemId": "pQrNmqHcK5R7Q9pEtfla"
      },
      "productionAudioFile": "production/episodes/feta/voice/voice-v2-blocks/05-proteins.mp3",
      "filename": "05-proteins.mp3",
      "docsAudioFile": "audio/episodes/feta/voice-v2-blocks/05-proteins.mp3",
