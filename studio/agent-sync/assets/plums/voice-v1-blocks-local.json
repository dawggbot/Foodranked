    {
      "id": "06-vitamins",
      "index": 5,
      "kind": "section",
      "sectionKey": "vitamins",
      "text": "Vitamin C is 11% daily value, useful for collagen formation and antioxidant support. Vitamin A is only 2% daily value, not bringing much vision or immune support. For fruit, vitamin C and vitamin A matter most.",
      "textSha256": "b98588214ff8efcc7665b1b77bea811d75cef88a87844b892966b3459e252547",
      "characterCount": 210,
      "byteLength": 328142,
