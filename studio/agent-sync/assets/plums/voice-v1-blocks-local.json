    },
    {
      "id": "07-minerals",
      "index": 6,
      "kind": "section",
      "sectionKey": "minerals",
      "text": "Potassium is 3% daily value, which may be the best number here, but still too low to matter much. All other minerals aren't worth talking about. For fruit, minerals are mostly just an extra bonus, and only matter when they are actually worth talking about.",
      "textSha256": "2b53615d9523f4b4f00ff35b1e6a21ef42278021627b9fa0fd7582a50d593200",
      "characterCount": 256,
      "byteLength": 331903,
